<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:left="@dimen/neo_offset" android:top="@dimen/neo_offset">
        <shape>
            <solid android:color="@color/neo_shadow_dark" />
            <corners android:radius="@dimen/radius_button" />
        </shape>
    </item>
    <item android:right="@dimen/neo_offset" android:bottom="@dimen/neo_offset">
        <shape>
            <gradient
                android:angle="270"
                android:startColor="@color/gold_light"
                android:endColor="@color/gold_dark" />
            <corners android:radius="@dimen/radius_button" />
        </shape>
    </item>
</layer-list>

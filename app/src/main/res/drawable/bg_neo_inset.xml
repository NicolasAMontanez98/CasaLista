<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <solid android:color="@color/neo_shadow_dark" />
            <corners android:radius="@dimen/radius_button" />
        </shape>
    </item>
    <item android:left="2dp" android:top="2dp">
        <shape>
            <solid android:color="@color/neo_shadow_light" />
            <corners android:radius="@dimen/radius_button" />
        </shape>
    </item>
    <item
        android:left="2dp"
        android:top="2dp"
        android:right="2dp"
        android:bottom="2dp">
        <shape>
            <solid android:color="@color/neo_inset" />
            <corners android:radius="@dimen/radius_button" />
        </shape>
    </item>
</layer-list>

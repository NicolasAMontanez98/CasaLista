<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_md">

        <TextView
            android:id="@+id/orderCode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_md"
            android:textAppearance="@style/TextAppearance.CasaLista.Title" />

        <TextView
            android:id="@+id/orderDetails"
            style="@style/Widget.CasaLista.Card.Neo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.CasaLista.Body" />

        <Button
            android:id="@+id/advanceButton"
            style="@style/Widget.CasaLista.Button.Gold"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:layout_marginTop="@dimen/space_lg" />

        <Button
            android:id="@+id/cancelButton"
            style="?attr/borderlessButtonStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/order_cancel"
            android:textColor="@color/state_error" />
    </LinearLayout>
</ScrollView>

<resources>
    <style name="TextAppearance.CasaLista.Title" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">@dimen/text_title</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.CasaLista.Body" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.CasaLista.Caption" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textSize">@dimen/text_caption</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="Widget.CasaLista.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:textColor">@color/gold_text</item>
    </style>

    <style name="Widget.CasaLista.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textColor">@color/gold_text</item>
    </style>

    <style name="Widget.CasaLista.Button.Gold" parent="Widget.Material3.Button">
        <item name="android:background">@drawable/bg_btn_gold</item>
        <item name="backgroundTint">@null</item>
        <item name="android:textColor">@color/on_gold</item>
    </style>

    <style name="Widget.CasaLista.Card.Neo" parent="">
        <item name="android:background">@drawable/bg_neo_raised</item>
        <item name="android:padding">@dimen/space_md</item>
    </style>

    <style name="Widget.CasaLista.GalleryImage" parent="">
        <item name="android:layout_width">240dp</item>
        <item name="android:layout_height">160dp</item>
        <item name="android:layout_marginEnd">@dimen/space_sm</item>
        <item name="android:background">@drawable/bg_neo_inset</item>
        <item name="android:src">@drawable/ic_home</item>
        <item name="android:scaleType">center</item>
        <item name="tint">@color/gold</item>
    </style>

    <style name="Widget.CasaLista.TextInput.Inset" parent="Widget.Material3.TextInputLayout.FilledBox">
        <item name="boxBackgroundColor">@color/neo_inset</item>
        <item name="boxStrokeWidth">0dp</item>
        <item name="boxStrokeWidthFocused">0dp</item>
    </style>
</resources>

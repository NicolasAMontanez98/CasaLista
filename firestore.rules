rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function role() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return signedIn() && role() == 'ADMIN';
    }

    function isSeller() {
      return signedIn() && role() == 'SELLER';
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn() && (
        isAdmin() ||
        (request.auth.uid == uid
          && request.resource.data.role == 'BUYER'
          && request.resource.data.active == true)
      );
      allow update: if signedIn() && (
        isAdmin() ||
        (request.auth.uid == uid
          && request.resource.data.role == resource.data.role
          && request.resource.data.active == resource.data.active)
      );
      allow delete: if signedIn() && (request.auth.uid == uid || isAdmin());
    }

    match /houses/{houseId} {
      allow read: if signedIn();
      allow create: if isAdmin() || (isSeller() && request.resource.data.status == 'En revisión');
      allow update: if isAdmin() || (isSeller() && (
        request.resource.data.status == 'En revisión'
        || !(resource.data.status in ['En revisión', 'Rechazada'])
      ));
      allow delete: if isAdmin() || isSeller();
    }
  }
}

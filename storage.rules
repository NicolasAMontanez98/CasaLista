rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() {
      return request.auth != null;
    }

    function canManageProducts() {
      return signedIn()
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role in ['SELLER', 'ADMIN'];
    }

    match /houses/{houseId}/{fileName} {
      allow read: if signedIn();
      allow create, update: if canManageProducts()
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if canManageProducts();
    }
  }
}
